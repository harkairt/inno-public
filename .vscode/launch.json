{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "npm run dev + chrome",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:clean",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "startDebugging",
        "name": "Launch Chrome",
        "killOnServerStop": true,
        "pattern": "Vite client warmed up in",
      },
    },
    {
      "name": "Launch Chrome",
      "type": "chrome",
      "request": "launch",
      "presentation": {
        "hidden": true,
      },
      "url": "http://localhost:3000",
      "runtimeArgs": [
        "--remote-debugging-port=9222",
        "--user-data-dir=/tmp/chrome-remote-debug",
        "--no-first-run",
        "--no-default-browser-check",
        "--disable-background-networking",
        "--disable-component-update",
        "--disable-sync",
        "--metrics-recording-only",
        "--disable-default-apps",
        "--mute-audio",
        "--auto-open-devtools-for-tabs",
        "--no-service-autorun",
        "--disable-breakpad",
        "--disable-features=Translate,AutofillServerCommunication,OptimizationHints,MediaRouter",
        "--disable-popup-blocking",
      ]
    },
    {
      "name": "npm run dev + proxyman chrome",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:clean",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "startDebugging",
        "name": "Launch Proxyman Chrome",
        "killOnServerStop": true,
        "pattern": "Vite client warmed up in",
      },
    },
    {
      "name": "Launch Proxyman Chrome",
      "type": "chrome",
      "request": "launch",
      "presentation": {
        "hidden": true,
      },
      "url": "http://localhost:3000",
      "runtimeArgs": [
        "--remote-debugging-port=9222",
        "--user-data-dir=/tmp/chrome-proxyman-debug",
        "--proxy-server=http://127.0.0.1:9090",
        "--proxy-bypass-list=<-loopback>",
        "--ignore-certificate-errors-spki-list=gDVg6jJ4Xh8ujnhNKQEZfG+oy0SckqCXh+RU4etBTBY=",
        "--disable-web-security",
        "--allow-running-insecure-content",
        "--allow-insecure-localhost",
        "--no-first-run",
        "--no-default-browser-check",
        "--disable-background-networking",
        "--disable-component-update",
        "--disable-sync",
        "--metrics-recording-only",
        "--disable-default-apps",
        "--mute-audio",
        "--auto-open-devtools-for-tabs",
        "--no-service-autorun",
        "--disable-breakpad",
        "--disable-features=Translate,AutofillServerCommunication,OptimizationHints,MediaRouter",
        "--disable-popup-blocking",
      ]
    },
  ],
}
