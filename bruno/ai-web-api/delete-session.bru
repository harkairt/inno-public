meta {
  name: DeleteSessionById
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/AIWebAPI/DeleteSessionById
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "sessionId": "{{sessionId}}",
    "agentId": {{agentId}}
  }
}

docs {
  Deletes a chat session permanently
}

tests {
