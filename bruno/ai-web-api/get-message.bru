meta {
  name: getMessage
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/AIWebAPI/getMessage
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "messageID": "message-id-here",
    "agentId": {{agentId}}
  }
}

docs {
  Retrieves a specific message by ID
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return message data", function() {
    expect(res.body.data).to.have.property("messageID");
    expect(res.body.data).to.have.property("messageText");
  });
}
