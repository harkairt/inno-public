meta {
  name: react
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/AIWebAPI/react
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "sessionId": "{{sessionId}}",
    "messageId": "message-id-here",
    "agentId": {{agentId}}
  }
}

docs {
  Adds a reaction/emoji to a message
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should add reaction", function() {
    expect(res.status).to.equal(200);
  });
}
