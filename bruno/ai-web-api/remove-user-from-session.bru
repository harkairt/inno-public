meta {
  name: removeUserFromSession
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/AIWebAPI/removeUserFromSession
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "sessionId": "{{sessionId}}",
    "agentId": {{agentId}},
    "userCode": "user-email@example.com"
  }
}

docs {
  Removes a user from shared chat session
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should remove user", function() {
    expect(res.status).to.equal(200);
  });
}
