meta {
  name: GetSessionUnreadMessages
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/AIWebAPI/GetSessionUnreadMessages
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "userEmail": "{{email}}",
    "sessionId": "{{sessionId}}",
    "agentId": {{agentId}}
  }
}

docs {
  Gets unread message count for specific session
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return number", function() {
    expect(res.body.data).to.be.a("number");
  });
}
