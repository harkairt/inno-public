meta {
  name: SetSessionMessageRating
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/AIWebAPI/SetSessionMessageRating
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "sessionId": "{{sessionId}}",
    "messageID": "message-id-here",
    "rating": true,
    "agentId": {{agentId}}
  }
}

docs {
  Rates a message as helpful or unhelpful
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should save rating", function() {
    expect(res.status).to.equal(200);
  });
}
