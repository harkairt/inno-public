meta {
  name: SetSessionName
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/AIWebAPI/SetSessionName
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "sessionId": "{{sessionId}}",
    "sessionName": "Updated Session Name",
    "agentId": {{agentId}}
  }
}

docs {
  Renames a chat session
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should update session name", function() {
    expect(res.status).to.equal(200);
  });
}
