meta {
  name: question/text
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/AIWebAPI/question/text
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "userCode": "{{email}}",
    "sessionId": "{{sessionId}}",
    "members": ["dev@innochat.hu", "{{email}}"],
    "agentId": {{agentId}},
    "question": "Hello!",
    "group": "",
    "pquestionType": 0
  }
}

docs {
  Sends a text message to a chat session
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return messageID", function() {
    expect(res.body.data).to.have.property("messageID");
  });
}
