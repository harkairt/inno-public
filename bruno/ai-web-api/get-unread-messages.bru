meta {
  name: Get Unread Messages
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/AIWebAPI/GetUnreadMessages
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "userCode": "{{email}}"
  }
}
