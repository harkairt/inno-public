meta {
  name: log
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/Log/log
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "loglevel": "info",
    "title": "Test log",
    "details": "Testing Bruno logging endpoint",
    "source": "bruno-collection"
  }
}

docs {
  Sends application logs to backend for monitoring. Fire-and-forget (doesn't throw errors).
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("fire-and-forget - no error validation", function() {
    // Logging endpoint doesn't return errors
    expect(res.status).to.be.oneOf([200, 201, 204]);
  });
}
