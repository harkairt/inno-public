meta {
  name: set-password
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/authentication/set-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "token": "reset-token-here",
    "newPassword": "{{password}}"
  }
}

docs {
  Sets new password after password reset
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should confirm password update", function() {
    if (res.body.success) {
      expect(res.body.success).to.include("password");
    }
  });
}
