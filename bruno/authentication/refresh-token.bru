meta {
  name: refresh-token
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/authentication/refresh-token
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "refreshToken": "{{refreshToken}}",
    "accessToken": "{{accessToken}}"
  }
}

docs {
  Refreshes expired access token using refresh token
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return new tokens", function() {
    expect(res.body.data).to.have.property("accessToken");
    expect(res.body.data).to.have.property("refreshToken");
  });

  test("should handle expired token", function() {
    if (res.status === 401) {
      expect(res.status).to.equal(401);
    }
  });
}

script:post-response {
  if (res.status === 200 && res.body.data?.accessToken) {
    bru.setVar("accessToken", res.body.data.accessToken);
    bru.setVar("refreshToken", res.body.data.refreshToken);
    console.log("✓ Tokens refreshed and stored!");
  } else if (res.body.error) {
    console.error("✗ Token refresh failed:", res.body.error);
  }
}
