meta {
  name: forgotten-password
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/authentication/forgotten-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "{{email}}"
  }
}

docs {
  Requests password reset email for forgotten password
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should send reset email", function() {
    if (res.body.success) {
      expect(res.body.success).to.include("email");
    }
  });
}
