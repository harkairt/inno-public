meta {
  name: get-selectable-users
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/user/get-selectable-users?email={{email}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
}

docs {
  Gets list of users available for chat sessions
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return users array", function() {
    expect(res.body.data).to.be.an("array");
  });

  test("users should have required fields", function() {
    if (res.body.data.length > 0) {
      const user = res.body.data[0];
      expect(user).to.have.property("id");
      expect(user).to.have.property("email");
      expect(user).to.have.property("name");
    }
  });
}
